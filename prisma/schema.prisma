// General Ledger — Chart of Accounts, Journal Entry, Approval Workflow.
// See prisma.config.ts for the CLI-time DATABASE_URL source.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

model Account {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  parentAccountId String?
  parentAccount   Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[]     @relation("AccountHierarchy")
  type            AccountType
  group           String
  currency        String        @default("INR")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  journalLines    JournalLine[]
}

enum JournalType {
  Manual
  Automatic
  Recurring
  Reversing
}

enum JournalStatus {
  Draft
  Approved
  Posted
  Closed
  Reversed
}

model Journal {
  id               String        @id @default(cuid())
  journalNumber    String        @unique
  voucherNumber    String?
  postingDate      DateTime
  accountingDate   DateTime
  fiscalYear       String
  accountingPeriod String
  journalType      JournalType   @default(Manual)
  status           JournalStatus @default(Draft)

  // Plain reference strings, not real foreign keys — Company/BusinessUnit/
  // Division/Branch/CostCenter/ProfitCenter/Project/Department master tables
  // are out of scope for this pass.
  companyId      String?
  businessUnitId String?
  divisionId     String?
  branchId       String?
  costCenterId   String?
  profitCenterId String?
  projectId      String?
  departmentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         JournalLine[]
  approvalSteps ApprovalStep[]
}

model JournalLine {
  id          String  @id @default(cuid())
  journalId   String
  journal     Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  description String?
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  lineNumber  Int
}

enum ApprovalLevel {
  Accountant
  FinanceManager
  FinancialController
  CFO
  CEO
}

enum ApprovalStepStatus {
  Pending
  Approved
  Rejected
}

model ApprovalStep {
  id           String             @id @default(cuid())
  journalId    String
  journal      Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  level        ApprovalLevel
  approverName String
  status       ApprovalStepStatus @default(Pending)
  date         DateTime?
}

// ==========================================
// Jig Development Module Models
// ==========================================

enum JigWorkflowStatus {
  Draft
  InProgress
  UnderReview
  RevisionRequired
  Approved
  ProductionRelease
}

enum JigPriority {
  Low
  Medium
  High
  Critical
}

enum JigCategory {
  DrillingJig
  WeldingJig
  TappingJig
  ReamingJig
  BoringJig
  MillingJig
  InspectionJig
  AssemblyJig
  RoboticJig
  ModularJig
  SpecialPurposeJig
}

enum JigDecision {
  Pending
  Approved
  ApprovedWithConditions
  RevisionRequired
  OnHold
  Rejected
}

model JigDevelopment {
  id               String            @id @default(cuid())
  jigId            String            @unique
  formCode         String
  projectName      String
  jigVersion       String            @default("v1.0.0")
  workflowStatus   JigWorkflowStatus @default(Draft)
  stage            Int               @default(1)
  createdOn        DateTime          @default(now())
  dateCreated      DateTime          @default(now())
  lastModified     DateTime          @updatedAt
  lastUpdated      DateTime          @updatedAt
  
  linkedProductId  String?
  linkedProductName String?
  linkedProcessId  String?
  linkedProcessName String?
  
  engineerName     String
  engineerEmail    String?
  engineerAvatar   String?
  jigNumber        String
  manufacturingPlant String
  productionLine   String?
  workstation      String?
  nextReviewDate   DateTime?

  jigName          String
  jigCategory      JigCategory
  productFamily    String?
  jigPurpose       String
  developmentStage String            @default("Jig Concept")
  priority         JigPriority       @default(Medium)
  riskLevel        String            @default("Low")
  healthIndex      Int               @default(100)

  // Design Specs
  cadModel               String?
  assemblyDrawing        String?
  detailDrawings         String?
  bom                    String?
  locatorDesign          String?
  clampDesign            String?
  materialSpecification  String?
  surfaceFinish          String?
  designReviewScore      Int               @default(0)

  // Manufacturing
  manufacturingProcess   String?
  cncProgram             String?
  machineAllocation      String?           // comma separated or JSON string
  materialRequirements   String?
  heatTreatment          Boolean           @default(false)
  surfaceTreatment       String?
  manufacturingLeadTime  Int               @default(0)
  manufacturingReadinessScore Int          @default(0)

  // Validation
  trialJig               Boolean           @default(false)
  dimensionalInspection  Boolean           @default(false)
  positioningAccuracy    Float             @default(0.0)
  repeatabilityTest      Float             @default(0.0)
  processCapabilityCp    Float             @default(0.0)
  processCapabilityCpk   Float             @default(0.0)
  safetyValidation       Boolean           @default(false)
  validationRemarks      String?
  validationScore        Int               @default(0)

  // Installation & Commissioning
  installationCompleted  Boolean           @default(false)
  processIntegration     Boolean           @default(false)
  operatorTraining       Boolean           @default(false)
  maintenancePlan        String?
  calibrationSchedule    String?
  productionApproval     Boolean           @default(false)
  commissioningScore     Int               @default(0)

  // Performance
  jigLifeCycles          Int               @default(500000)
  productionCycles       Int               @default(0)
  toolWearPercentage     Float             @default(0.0)
  downtimeHoursPerMonth  Float             @default(0.0)
  mtbfHours              Int               @default(720)
  mttrHours              Float             @default(1.0)
  oeeContribution        Float             @default(0.0)
  performanceScore       Int               @default(0)

  // Derived Overall Score & Recommendation
  aiEngineeringScore     Int               @default(0)
  overallReadinessScore  Int               @default(0)
  recommendation         String            @default("Approve for Production")

  attachments            JigAttachment[]
  approvals              JigApprovalStep[]
  activities             JigActivityLog[]
  aiAssessment           JigAiAssessment?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model JigAttachment {
  id           String         @id @default(cuid())
  jigId        String
  jig          JigDevelopment @relation(fields: [jigId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  documentType String
  version      String         @default("v1.0")
  uploadedBy   String
  uploadedDate DateTime       @default(now())
  fileSize     String
  status       String         @default("Active")
  downloadUrl  String?
  createdAt    DateTime       @default(now())
}

model JigApprovalStep {
  id           String         @id @default(cuid())
  jigId        String
  jig          JigDevelopment @relation(fields: [jigId], references: [id], onDelete: Cascade)
  role         String
  person       String
  decision     JigDecision    @default(Pending)
  date         DateTime?
  comments     String?
  status       String         @default("Pending")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model JigActivityLog {
  id           String         @id @default(cuid())
  jigId        String
  jig          JigDevelopment @relation(fields: [jigId], references: [id], onDelete: Cascade)
  user         String
  action       String
  description  String
  prevStatus   String?
  newStatus    String?
  timestamp    DateTime       @default(now())
}

model JigAiAssessment {
  id                       String         @id @default(cuid())
  jigId                    String         @unique
  jig                      JigDevelopment @relation(fields: [jigId], references: [id], onDelete: Cascade)
  feasibilityIndex         Int            @default(88)
  manufacturabilityIndex   Int            @default(85)
  toleranceStackRisk       String         @default("Low Risk")
  costOptimizationNotes    String
  complianceCheckPassed    Boolean        @default(true)
  toolPathOptimization     String
  wearPrediction           String
  failurePrediction        String
  maintenanceRecommendation String
  costOptimizationPercentage Int          @default(7)
  aiEngineeringScore       Int            @default(89)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

// ==========================================
// Factory Layout Design Module Models
// ==========================================

model FactoryLayout {
  id                    String              @id @default(cuid())
  layoutId              String              @unique
  formCode              String
  projectName           String
  layoutVersion         String              @default("v1.2.0")
  workflowStatus        String              @default("In Progress")
  stage                 Int                 @default(3)
  createdOn             DateTime            @default(now())
  dateCreated           DateTime            @default(now())
  lastModified          DateTime            @updatedAt
  lastUpdated           DateTime            @updatedAt

  plantName             String
  facilityLocation      String
  engineerName          String
  totalLandArea         Float               @default(120000.0)
  builtUpArea           Float               @default(45000.0)
  productionCapacity    Int                 @default(250000)
  nextReviewDate        DateTime?

  factoryName           String
  plantType             String              @default("Greenfield Factory")
  industrySegment       String              @default("Electric Vehicles")
  factoryObjective      String
  developmentStage      String              @default("Detailed Layout")
  priority              String              @default("High")

  // Layout Planning Scores & Files
  layoutPlanningScore   Int                 @default(88)
  masterLayoutDrawing   String?
  shopFloorLayout       String?
  productionLineLayout  String?
  utilityLayout         String?
  materialFlowDiagram   String?
  equipmentLayout       String?
  warehouseLayout       String?
  officeLayout          String?

  // Infrastructure
  infrastructureScore   Int                 @default(86)
  productionAreas       String?             // comma-separated
  assemblyAreas         String?             // comma-separated
  warehouseCapacityM2   Float               @default(8500.0)
  loadingUnloadingBays  Int                 @default(6)
  utilitySystems        String?             // comma-separated
  maintenanceWorkshop   Boolean             @default(true)

  // Material Flow & Logistics
  logisticsScore        Int                 @default(85)
  rawMaterialFlow       String?
  wipFlow               String?
  finishedGoodsFlow     String?
  forkliftRoutes        String?
  agvAmrRoutes          String?
  materialHandlingEq    String?             // comma-separated

  // Utilities & Safety
  utilitySafetyScore    Int                 @default(88)
  electricalLayout      String?
  compressedAirLayout   String?
  waterLayout           String?
  fireSafetyLayout      String?
  emergencyExitPlan     String?
  ehsCompliance         Boolean             @default(true)

  // Factory Performance
  factoryEfficiencyScore Int                @default(87)
  spaceUtilization      Float               @default(78.0)
  materialTravelDistance Float              @default(1.62)
  throughputUnitsPerYear Int                @default(250000)
  warehouseEfficiency   Float               @default(92.0)
  energyEfficiency      Float               @default(86.0)
  equipmentAccessibility Float              @default(90.0)

  // Overall Score & Recommendation
  aiFactoryScore        Int                 @default(89)
  overallReadinessScore Int                 @default(87)
  recommendation        String              @default("Approve Factory Layout")

  attachments           FactoryAttachment[]
  approvals             FactoryApprovalStep[]
  activities            FactoryActivityLog[]
  aiAssessment          FactoryAiAssessment?
  simulations           FactorySimulation[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model FactoryAttachment {
  id           String        @id @default(cuid())
  layoutId     String
  layout       FactoryLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  documentType String
  version      String        @default("v1.0")
  uploadedBy   String
  uploadedDate DateTime      @default(now())
  fileSize     String
  status       String        @default("Active")
  downloadUrl  String?
  createdAt    DateTime      @default(now())
}

model FactoryApprovalStep {
  id           String        @id @default(cuid())
  layoutId     String
  layout       FactoryLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  role         String
  person       String
  decision     String        @default("Pending")
  date         DateTime?
  comments     String?
  status       String        @default("Pending")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model FactoryActivityLog {
  id           String        @id @default(cuid())
  layoutId     String
  layout       FactoryLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  user         String
  action       String
  description  String
  prevStatus   String?
  newStatus    String?
  timestamp    DateTime      @default(now())
}

model FactoryAiAssessment {
  id                            String        @id @default(cuid())
  layoutId                      String        @unique
  layout                        FactoryLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutOptimization            String
  bottleneckPrediction          String
  materialFlowOptimization      String
  capacityExpansionRec          String
  safetyImprovementRec          String
  aiFactoryScore                Int           @default(89)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
}

model FactorySimulation {
  id           String        @id @default(cuid())
  layoutId     String
  layout       FactoryLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  simulationType String      // Material Flow, Capacity, Emergency Evacuation
  status       String        @default("Completed")
  resultSummary String
  passed       Boolean       @default(true)
  runDate      DateTime      @default(now())
}

