// ==========================================
// SOP Development Module Models
// ==========================================

model SopRecord {
  id                      String                    @id @default(cuid())
  sopId                   String                    @unique
  formCode                String
  title                   String
  sopNumber               String                    @default("SOP-MFG-001")
  revision                String                    @default("2.0")
  workflowStatus          String                    @default("In Review")
  stage                   Int                       @default(2)
  createdOn               DateTime                  @default(now())
  dateCreated             DateTime                  @default(now())
  effectiveDate           DateTime?
  nextReviewDate          DateTime?
  lastModified            DateTime                  @updatedAt
  lastUpdated             DateTime                  @updatedAt

  department              String
  processOwner            String
  sopCategory             String                    @default("Manufacturing")
  businessFunction        String                    @default("Manufacturing Operations")
  processName             String                    @default("Production Process Control")
  processObjective        String
  scope                   String
  applicability           String
  triggerEvent            String
  expectedOutput          String
  priority                String                    @default("High")

  totalDurationMins       Int                       @default(45)
  overallReadinessScore   Int                       @default(87)
  procedureReadinessScore Int                       @default(85)
  complianceScore         Int                       @default(90)
  riskScore               Int                       @default(82)
  trainingScore           Int                       @default(88)
  aiDocumentationScore    Int                       @default(91)
  recommendation          String                    @default("Publish & Release SOP")

  steps                   SopProcedureStep[]
  resources               SopResourceRequirement[]
  compliance              SopComplianceRequirement?
  risk                    SopRiskAssessment?
  training                SopTrainingRequirement?
  attachments             SopAttachment[]
  approvals               SopApprovalStep[]
  activities              SopActivityLog[]
  aiAssessment            SopAiAssessment?

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model SopProcedureStep {
  id                      String          @id @default(cuid())
  sopRecordId             String
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  stepNumber              Int
  description             String
  responsibleRole         String
  durationMins            Int             @default(5)
  requiredDocuments       String?
  notes                   String?
  safetyCheck             String?
  qualityCheck            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model SopResourceRequirement {
  id                      String          @id @default(cuid())
  sopRecordId             String
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  category                String
  name                    String
  itemCount               Int             @default(1)
  verified                Boolean         @default(true)
  status                  String          @default("Verified")
}

model SopComplianceRequirement {
  id                      String          @id @default(cuid())
  sopRecordId             String          @unique
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  applicableStandards     String          @default("ISO 9001:2015, ISO 14001:2015")
  regulatoryRequirements  String          @default("Factories Act, OSHA, BIS")
  internalPolicies        String          @default("Quality Policy, EHS Policy")
  auditRequirements       String          @default("Internal Audit, Customer Audit")
  complianceScore         Int             @default(90)
}

model SopRiskAssessment {
  id                      String          @id @default(cuid())
  sopRecordId             String          @unique
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  riskLevel               String          @default("Medium")
  ehsRequirements         String
  emergencyProcedure      String
  riskReadinessScore      Int             @default(82)
}

model SopTrainingRequirement {
  id                      String          @id @default(cuid())
  sopRecordId             String          @unique
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  trainingRequired        Boolean         @default(true)
  targetAudience          String
  competencyRequirement   String
  trainingReadinessScore  Int             @default(88)
}

model SopAttachment {
  id                      String          @id @default(cuid())
  sopRecordId             String
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  fileName                String
  fileType                String
  documentType            String
  version                 String          @default("v2.0")
  uploadedBy              String
  uploadedDate            DateTime        @default(now())
  fileSize                String
  status                  String          @default("Active")
  downloadUrl             String?
  createdAt               DateTime        @default(now())
}

model SopApprovalStep {
  id                      String          @id @default(cuid())
  sopRecordId             String
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  role                    String
  person                  String
  decision                String          @default("Pending")
  date                    DateTime?
  comments                String?
  status                  String          @default("Pending")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model SopActivityLog {
  id                      String          @id @default(cuid())
  sopRecordId             String
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  user                    String
  action                  String
  description             String
  prevStatus              String?
  newStatus               String?
  timestamp               DateTime        @default(now())
}

model SopAiAssessment {
  id                      String          @id @default(cuid())
  sopRecordId             String          @unique
  sopRecord               SopRecord       @relation(fields: [sopRecordId], references: [id], onDelete: Cascade)
  aiSopReview             String
  aiComplianceAnalysis    String
  aiProcessOptimization   String
  aiRiskPrediction        String
  aiRevisionRecommendation String
  aiDocumentationScore    Int             @default(91)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}





